# Database PostgreSQL Supabase (pakai Transaction Pooler :6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Storage untuk unggah bukti snapshot Before (harus sama dengan BE-Patra)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_BUCKET="patra-evidence"

# Model ONNX (otomatis diunduh saat boot jika file lokal model/best.onnx belum ada)
MODEL_PATH="model/best.onnx"
MODEL_URL="https://portal-patra.vercel.app/models/best.onnx"

# Pengaturan hemat RAM & beban CPU untuk running 24 jam
FRAME_INTERVAL_SEC="3"
CONF_THRESH="0.30"
IOU_NMS="0.45"
STREAM_TIMEOUT_MS="5500"
CAMERA_COOLDOWN_SEC="30"
CAMERA_REFRESH_SEC="600"

# Opsional: batasi kota tertentu dipisah koma (kosongkan = pantau semua kota aktif di DB)
WORKER_CITIES="Kota Jakarta Pusat,Kota Semarang"
MAX_CAMERAS="60"
